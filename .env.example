# MySQL 8 connection (server-side only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=vage_clothing
DB_CONNECTION_LIMIT=10

# Behavioural product analytics only; commerce records remain in MySQL.
MONGODB_URI=mongodb+srv://replace_with_user:replace_with_password@replace_with_cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vage_product_intelligence
PRODUCT_INTELLIGENCE_ENABLED=true

# Generate a fresh random secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars

# VAGE checkout provider. This project checkout is configured to use Razorpay Standard Checkout.
PAYMENT_PROVIDER=RAZORPAY
# Demo payments should remain disabled when using Razorpay.
ALLOW_DEMO_PAYMENTS=false

# Cashfree sandbox credentials (leave blank while using local DEMO mode)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
APP_BASE_URL=http://localhost:3000

# Razorpay Test Mode credentials (server-side secrets)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Dedicated VAGE Gmail mailbox (server-side only)
# Create a Google App Password after enabling 2-Step Verification.
GMAIL_USER=vageclothing@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
# Contact Us notifications are delivered here; defaults to GMAIL_USER.
VAGE_CONTACT_TO=vageclothing@gmail.com

# Protect scheduled email/reconciliation jobs; generate a separate random secret.
CRON_SECRET=replace_with_a_unique_random_cron_secret_at_least_32_chars
